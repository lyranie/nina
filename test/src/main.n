mod test.main;

use std.io;
use std.core.string.builder;
use std.core.allocator.arena;

int main() {
    Arena alloc = arena.create(64 * 1024);

    StringBuilder builder = builder.create(&alloc);

    builder.append(&builder, "Test");
    // builder.append(&builder, 5);
    builder.append(&builder, true);

    io.printn(builder.to_string(&builder));

    arena.reset(&alloc);
    arena.free(&alloc);

    ret 0;
}
