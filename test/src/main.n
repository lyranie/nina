mod test.main;

use std.io;
use std.encoding.json;
use std.core.allocator.arena;

int main() {
    Arena alloc = arena.create(64 * 1024);

    String json = "[{ \"string\": \"Penis\", \"bool\": true }]"; // \"int\": 420, \"real\": 69.42,

    try {
        JsonValue* value = json.parse(&alloc, json);
        io.printn(json.to_string(&alloc, value));
    } catch (Err e) {
        io.printn(e.message);
    }

    arena.reset(&alloc);
    arena.free(&alloc);

    ret 0;
}
