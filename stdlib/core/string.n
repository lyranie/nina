mod std.core.string;

use std.core.allocator.arena;
use std.io;

type OutOfBoundsErr();

int index_of(String s, char c) {
    char* t = s.ptr;

    while (*t != 0) {
        if (*t == c) {
            ret (s.ptr - t) as int;
        }

        t++;
    }

    ret -1;
}

String copy(Arena* alloc, String s) {
    char* copy = arena.alloc(alloc, char.$size * s.len, char.$size);

    int i = 0;
    while (i < s.len) {
        copy[i] = s[i++];
    }

    ret copy[0:i] as String;
}

char char_at(String s, int i) : OutOfBoundsErr {
    if (i >= s.len) {
        err OutOfBoundsErr();
    }

    ret s[i];
}

