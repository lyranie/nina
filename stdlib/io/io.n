mod std.io;

use std.io.file;
use libc;

const File STDOUT = new File(1);
const File STDERR = new File(2);

void print(any a) {
    switch (a.$typeid) {
    case String.$typeid:
        String s = a.$data as String;
        libc.write(STDOUT.fd, s.ptr, s.len);
        break;
    case int.$typeid:
        libc.printf("%d", a.$data as int);
        break;
    case bool.$typeid:
        if (a.$data) {
            libc.printf("true");
        } else {
            libc.printf("false");
        }
        break;
    case real.$typeid:
        libc.printf("%.2f", a.$data as real);
        break;
    case char.$typeid:
        libc.printf("%c", a.$data as char);
        break;
    case long.$typeid:
        libc.printf("%d", a.$data as long);
        break;
    default:
        switch (a.$typekind) {
        case $$STRUCT:
            // TODO: add way to iterate fields after adding slices
            libc.printf("{");
/*
            if (a.$data.$fields.len > 0) {
                libc.printf(" ");
                print(a.$data.$fields[0].name);
                libc.printf(": ");
                print(a.$data.$fields[0].value);

                if (a.$data.$fields.len > 1) {
                    int i = 1;
                    while (i < a.$data.$fields.len) {
                        libc.printf(", ");
                        print(a.$data.$fields[0].name);
                        libc.printf(": ");
                        print(a.$data.$fields[0].value);
                        // print ,
                        // print field
                    }
                }
            }
*/
            libc.printf(" }");
            break;
        case $$POINTER:
            void* ptr = a.$data as void*;
            if (ptr) {
                libc.printf("%p", ptr);
            } else {
                libc.printf("null");
            }
            break;
        default:
            libc.printf("<UNKNOWN>");
            break;
        }
        break;
    }
}

void printn(any a) {
    print(a);
    libc.printf("\n");
}

