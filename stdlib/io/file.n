mod std.io.file;

use std.core.allocator.arena;
use std.core.string;
use libc;

rec File(int fd);

const int O_RDONLY = 0;
const int O_WRONLY = 1;
const int O_RDWR   = 2;
const int O_CREAT  = 64;
const int O_TRUNC  = 512;
const int O_APPEND = 1024;

const int SEEK_SET = 0;
const int SEEK_CUR = 1;
const int SEEK_END = 2;

const int DEFAULT_MODE = 420;

rec FileReadErr(String filename, String message);

int errno() {
    ret *libc.__errno_location();
}

int mode_to_flags(String mode) {
    switch (mode) {
    case "r":  ret O_RDONLY;
    case "r+": ret O_RDWR;
    case "w":  ret O_WRONLY + O_CREAT + O_TRUNC;
    case "w+": ret O_RDWR + O_CREAT + O_APPEND;
    case "a":  ret O_WRONLY + O_CREAT + O_APPEND;
    case "a+": ret O_RDWR + O_CREAT + O_APPEND;
    case "rb": ret O_RDONLY;
    case "wb": ret O_WRONLY + O_CREAT + O_TRUNC;
    case "ab": ret O_WRONLY + O_CREAT + O_APPEND;
    default:   ret -1;
    }
}

File open(String path, String mode) {
    int flags = mode_to_flags(mode);

    if (flags == -1) {
        ret new File(-1);
    }

    int fd = libc.open(path.ptr, flags, DEFAULT_MODE);

    ret new File(fd);
}

int close(File file) {
    ret libc.close(file.fd);
}

int read(File file, void* buf, int count) {
    ret libc.read(file.fd, buf, count);
}

int write(File file, void* buf, int count) {
    ret libc.write(file.fd, buf, count);
}

int seek(File file, int offset, int whence) {
    ret libc.lseek(file.fd, offset, whence);
}

int size(File file) {
    int cur = libc.lseek(file.fd, 0, SEEK_CUR);

    if (cur == -1) {
        ret -1;
    }

    int end = libc.lseek(file.fd, 0, SEEK_END);

    if (end == -1) {
        ret -1;
    }

    libc.lseek(file.fd, cur, SEEK_SET);

    ret end;
}

// pass aloocator for char* alloc
String read_text(Arena* alloc, String path) : FileReadErr {
    File file = open(path, "rb");
    if (file.fd == -1) {
        err FileReadErr(path, "File not found");
    }

    int total = size(file);
    if (total == -1) {
        close(file);
        err FileReadErr(path, "File is corrupted");
    }

    char* buffer = arena.alloc(alloc, total + 1, 8);
    if (!buffer) {
        close(file);
        err FileReadErr(path, "Failed to allocate");
    }

    int received = 0;
    while (received < total) {
        int n = read(file, buffer + received, total - received);
        if (n <= 0) {
            // fix; add free_ptr function
            // arena.free(alloc, buffer);
            close(file);
            err FileReadErr(path, "Failed to read");
        }

        received = received + n;
    }

    buffer[total] = 0;
    close(file);

    ret buffer[0:total] as String;
}

long write_text(String path, String data) {
    File file = open(path, "wb");
    if (file.fd == -1) {
        ret -1 as long;
    }

    int written = 0;
    while (written < data.len) {
        long n = write(file, data.ptr + written, data.len - written);
        if (n <= 0) {
            close(file);
            ret -1 as long;
        }

        written = written + n;
    }

    close(file);
    ret 0;
}
